# Server Configuration
PORT=5000
NODE_ENV=production
# Primary MongoDB connection string (Atlas or local). MONGO_URI is also supported as an alias.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/audit-trail?retryWrites=true&w=majority
# Allowed frontend origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Client Configuration (Vite)
# Production backend base URL (omit trailing slash). Leave empty or unset if served on same domain/proxy.
VITE_API_URL=https://your-backend-domain.onrender.com

